// Schema do banco de dados - Rede Única de Baterias Bandeirantes | App de Tarefas
// Rode `npm run db:push` depois de configurar DATABASE_URL no .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Autenticação ----------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(FUNCIONARIO)
  // Número de WhatsApp do funcionário (com DDD), usado para o botão
  // "Enviar no WhatsApp" nas tarefas. Opcional — só é pedido quando alguém
  // tenta mandar uma tarefa pra essa pessoa e ainda não tem o número salvo.
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks         Task[]    @relation("TaskOwner")
  assignedTasks Task[]    @relation("TaskAssignee")
  pushSubscriptions PushSubscription[]
  stockMovements StockMovement[]
  aiMessages    AiMessage[]

  @@map("users")
}

// Inscrição de notificações push (Web Push) de um dispositivo/navegador do usuário.
// Cada usuário pode ter mais de uma (ex: celular + computador).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

enum Role {
  ADMIN         // dono da loja, gerencia tudo
  FUNCIONARIO   // colaborador, cria e move tarefas
}

// Controla se o push do "Relatório semanal" já foi mandado numa determinada
// semana, pra nunca duplicar mesmo que o serviço externo de cron chame o
// endpoint mais de uma vez na mesma segunda-feira.
model WeeklyReportSent {
  id        String   @id @default(cuid())
  weekStart DateTime @unique // segunda-feira 00:00 da semana do relatório
  sentAt    DateTime @default(now())

  @@map("weekly_report_sent")
}

// ---------- Espaços de tarefas ----------
// Cada tarefa pertence a um "espaço": pessoal (só do dono) ou da loja (compartilhado)

enum Workspace {
  PESSOAL
  LOJA
}

enum Status {
  A_FAZER
  FAZENDO
  FEITO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

enum BatteryType {
  IMPAR
  UNICA
  BATS
  HELIAR
  EXCELL
  OUTRAS
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  workspace   Workspace @default(LOJA)
  status      Status    @default(A_FAZER)
  priority    Priority  @default(MEDIA)
  dueDate     DateTime?
  position    Int       @default(0) // ordenação dentro da coluna
  completedAt DateTime? // preenchido quando a tarefa é marcada como concluída (some da tela principal, mas fica salva)
  reminderSentAt DateTime? // preenchido quando o lembrete de 15 min antes já foi enviado (evita repetir)

  // Dados do cliente (opcional, usado nas tarefas da loja para atendimentos)
  clientName    String?
  clientPhone   String?
  clientAddress String?
  batteryType   BatteryType?

  // Foto da garantia da bateria (opcional). Guardada no Vercel Blob — aqui
  // fica só o link público da imagem, não o arquivo em si.
  warrantyPhotoUrl String?

  ownerId     String
  owner       User      @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspace, status])
  @@index([workspace, completedAt])
  @@map("tasks")
}

// ---------- Estoque da loja ----------
// Cada produto é uma combinação única de marca + amperagem (ex: "Moura 60Ah").
// A quantidade fica sempre atualizada aqui; o histórico de cada mudança
// (quem, quando, quanto, entrada ou saída) fica em StockMovement — é o que
// alimenta "produto que mais/menos saiu" no relatório semanal e no painel.

enum MovementType {
  ENTRADA
  SAIDA
}

model Product {
  id          String   @id @default(cuid())
  brand       String // Marca (ex: Moura, Heliar, Zetta)
  amperage    Int // Amperagem em Ah (ex: 60)
  quantity    Int      @default(0) // saldo atual em estoque — nunca fica negativo
  // Abaixo desse número, o produto entra no alerta de "estoque baixo" no
  // relatório semanal. Opcional — se não definir, não gera alerta.
  minQuantity Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements StockMovement[]

  @@unique([brand, amperage])
  @@map("products")
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Int // sempre positivo — o "type" indica a direção
  note      String? // opcional: motivo (ex: "venda balcão", "troca por garantia", "compra fornecedor X")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ---------- Assistente de IA ----------
// Histórico de conversa com o assistente (🧠 Assistente RUB), um por usuário.
// Guardamos aqui pra conversa sobreviver a um recarregamento de página.
// Mensagens de ferramenta (toolName/toolArgs/toolResult) só existem a partir
// da fase em que o assistente ganha acesso aos dados do app (fase 2).

enum AiMessageRole {
  USER
  MODEL
  TOOL
}

model AiMessage {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       AiMessageRole
  content    String        @db.Text
  toolName   String?
  toolArgs   Json?
  toolResult Json?
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
  @@map("ai_messages")
}
