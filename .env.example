# URL de conexão do banco Postgres (Neon). Pegue em https://neon.tech após criar o projeto.
# Use a URL com "?sslmode=require" no final.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.neon.tech/rub_tarefas?sslmode=require"

# Chave secreta usada pelo NextAuth para assinar sessões.
# Gere uma com o comando: openssl rand -base64 32
AUTH_SECRET="cole_aqui_uma_chave_aleatoria_gerada"

# URL pública do site (em produção, a URL do seu projeto no Vercel)
NEXTAUTH_URL="http://localhost:3000"

# Código de convite que a loja usa para permitir novos cadastros de funcionários
STORE_INVITE_CODE="defina_um_codigo_aqui"

# --- Notificações push (lembrete de tarefa 15 min antes) ---
# Gerar uma vez com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="cole_aqui_a_chave_publica"
VAPID_PRIVATE_KEY="cole_aqui_a_chave_privada"
VAPID_SUBJECT="mailto:seuemail@exemplo.com"
# A mesma chave pública, mas exposta ao navegador (precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="cole_aqui_a_mesma_chave_publica"

# Senha simples que protege o endpoint de lembretes (/api/cron/lembretes) contra
# chamadas de terceiros. Gere uma com: openssl rand -hex 16
CRON_SECRET="defina_uma_senha_aleatoria_aqui"
